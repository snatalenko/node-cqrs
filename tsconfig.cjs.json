{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo.cjs",
    "outDir": "./dist/cjs",
    "noEmit": false,
    "declaration": false
  }
}
